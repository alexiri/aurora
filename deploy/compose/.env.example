# Copy is created by setup.sh (which fills every empty/missing secret).
# Never commit .env.
AURORA_VERSION=dev
POSTGRES_PASSWORD=
AURORA_ENCRYPTION_KEYS=
AURORA_ENCRYPTION_ACTIVE_KEY=k1
# Signing key / internal secret: a bare base64 value (ring v0) or a ring `id:base64,id2:base64`
# with the matching *_ACTIVE_KEY (docs/operator/key-rotation.md).
AURORA_SIGNING_KEY=
AURORA_SIGNING_ACTIVE_KEY=
AURORA_INTERNAL_SECRET=
AURORA_INTERNAL_ACTIVE_KEY=
AURORA_RUNNER_SESSION_KEY=
AURORA_RUNNER_TOKEN=
AURORA_CONNECTOR_TOKEN=
# Host uid/gid the hosted runner runs as (rootless podman socket access); setup.sh fills them.
AURORA_UID=
AURORA_GID=
# Sandbox image on the host podman (hosted profile). The claude-code harness needs aurora-llm-sandbox.
AURORA_SANDBOX_IMAGE=localhost/aurora-sandbox:0.1.0
# Profiles: hosted (runner), connector-fake, llm-mock
COMPOSE_PROFILES=
