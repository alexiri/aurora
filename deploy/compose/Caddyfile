{
	auto_https off
	admin off
}

:4000 {
	# Never route internal or metrics endpoints.
	@blocked path /internal /internal/* /metrics /metrics/*
	handle @blocked {
		respond 404
	}

	request_body {
		max_size 64MB
	}

	# SSE and long-poll endpoints: no buffering.
	@stream path /v1/conversations/*/stream /v1/approvals/* /v1/runner/work /v1/connector/ops/claim
	handle @stream {
		reverse_proxy aurora-api:4101 {
			flush_interval -1
			transport http {
				read_timeout 10m
			}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /v1/* {
		reverse_proxy aurora-api:4101 {
			transport http {
				read_timeout 120s
			}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy aurora-web:4100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
