#!/usr/bin/env python3
"""grafana-alert: managed Grafana alert rules; see SKILL.md. Exit: 0 ok, 1 failed, 2 usage."""
import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
import tempfile

TIMEOUT = 300
UID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
UNIT_S = {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}
CTRL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")
FIELD_RE = re.compile(r"^[A-Za-z0-9_.@-]{1,200}$")
DS_TYPE = {"prometheus": "prometheus", "logs": "grafana-opensearch-datasource"}
# A log metric's reduce and min_doc_count. An empty bucket is a zero for a count or sum; for
# the others it has no value, which would empty the whole reduce, so it is left out.
LOG_METRICS = {"count": ("sum", "0"), "sum": ("sum", "0"), "avg": ("mean", "1"),
               "max": ("max", "1"), "min": ("min", "1")}
SHOWN_MAX = 200  # what an approval card shows of a value
BUCKETS_MAX = 60
ACCOUNT = None
FOLDER_CAP, SERVICE_CAP = 10, 5
MIN_EVAL_S, MIN_FOR_S = 60, 120
STRIP = ("id", "updated", "updatedBy", "created", "createdBy", "version", "provenance", "metadata")
# Read-only fields the server adds to every stored step model.
STEP_STRIP = ("intervalMs", "maxDataPoints")


def clean(v):
    """Text safe to print: control characters (terminal escapes) are replaced."""
    return CTRL.sub("?", str(v))


def die(msg, code=2):
    print(f"grafana-alert: {clean(msg)}", file=sys.stderr)
    sys.exit(code)


def tmp_dir():
    d = os.path.join(os.environ.get("TMPDIR") or "/tmp", "aurora-agent")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d


def mktemp(suffix):
    fd, path = tempfile.mkstemp(prefix="grafana-alert-", suffix=suffix, dir=tmp_dir())
    os.close(fd)
    return os.path.abspath(path)


def agent(operation, *args, body=None):
    """One `aurora-agent call grafana` (argument list, no shell). Returns (ok, parsed JSON or None, text)."""
    out = mktemp(".json")
    cmd = ["aurora-agent", "call", "grafana", operation, *args]
    if body is not None:
        cmd += ["--body", "@" + body]
    if ACCOUNT:
        cmd += ["--account", ACCOUNT]
    cmd += ["--out", out]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=TIMEOUT)
        text = (r.stdout + r.stderr).strip()
        data = None
        if r.returncode == 0:
            try:
                with open(out, encoding="utf-8") as f:
                    data = json.load(f)
            except (OSError, ValueError) as e:
                return False, None, f"the answer could not be read: {e}"
        return r.returncode == 0, data, text
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, None, f"aurora-agent: {e}"
    finally:
        try:
            os.unlink(out)
        except OSError:
            pass


def parse_step(s):
    m = re.fullmatch(r"(\d+)([smhdw])", s or "")
    if not m or int(m.group(1)) == 0:
        die(f"bad step {s!r}: use a number and s, m, h, d or w, such as 30s or 5m")
    return int(m.group(1)) * UNIT_S[m.group(2)]


def send(op, body, *args):
    path = None
    if body is not None:
        path = mktemp(".json")
        with open(path, "w", encoding="utf-8") as f:
            json.dump(body, f)
    try:
        ok, data, text = agent(op, *args, body=path)
    finally:
        if path:
            os.unlink(path)
    if not ok:
        die(f"{op} failed: {text or 'no answer'}", 1)
    return data


def today():
    return dt.datetime.now(dt.timezone.utc).date()


def as_date(s):
    try:
        return dt.date.fromisoformat(str(s or ""))
    except ValueError:
        return None


def days_of(s):
    m = re.fullmatch(r"(\d+)d", s or "")
    if not m or not 1 <= int(m.group(1)) <= 30:
        die("--expires is 1d to 30d")
    return int(m.group(1))


def check_expr(expr):
    if len(expr) > SHOWN_MAX:
        die(f"--expr is at most {SHOWN_MAX} characters, so that an approval shows it in full")
    w = max((int(m.group(1)) * UNIT_S[m.group(2)]
             for m in re.compile(r"\[(\d+)([smhdw])\]").finditer(expr)), default=0)
    if w < 300:
        die("the expression needs a range of at least 5 minutes, such as [5m]: one-sample "
            "comparisons alert on peaks shorter than the step")
    return w


def mine(label, folder=None):
    data = send("list_alert_rules", None)
    if not isinstance(data, list):
        die("list_alert_rules did not answer a list", 1)
    return [r for r in data if isinstance(r, dict)
            and (r.get("labels") or {}).get("managed_by") == label
            and (not folder or r.get("folderUID") == folder)]


def check_receiver(name):
    data = send("list_contact_points", None)
    names = sorted({c.get("name") for c in data if isinstance(c, dict) and c.get("name")}) \
        if isinstance(data, list) else []
    if name not in names:
        die(f"no contact point named {name!r}; a person makes contact points")


def check_ds(ds, kind):
    """The data source's type, which must be the one the rule's kind queries."""
    data = send("list_datasources", None)
    types = {d.get("uid"): d.get("type") for d in data if isinstance(d, dict)} \
        if isinstance(data, list) else {}
    if types.get(ds) != DS_TYPE[kind]:
        die(f"--ds {ds} is a {types.get(ds) or 'unknown'} data source: --expr needs a "
            f"{DS_TYPE['prometheus']} data source and --logs a {DS_TYPE['logs']} one; no other "
            "type can have a rule")
    return types[ds]


def field_arg(value, what):
    if not FIELD_RE.match(value or ""):
        die(f"{what}: {value!r} is not a field name (letters, digits, _ . @ -, at most 200 characters)")
    return value


def check_lucene(query):
    if not query.strip():
        die("--logs is empty")
    if "\n" in query or "\t" in query or CTRL.search(query):
        die("--logs is one line of text")
    if len(query) > SHOWN_MAX:
        die(f"--logs is at most {SHOWN_MAX} characters, so that an approval shows it in full")
    # Escaped pairs and quoted phrases are plain text. What is left must hold no regular
    # expression and no wildcard that starts a term (`*` alone matches all): both are costly.
    bare = re.sub(r'\\.|"(?:\\.|[^"\\])*"', "x", query)
    if "/" in bare:
        die('--logs has a regular expression (/.../): quote a text with a slash, as url:"/api"')
    if re.search(r"(?<![^\s(:+\-!|&\[{<>=])(?!\*+(?![^\s)\]}^]))[*?]", bare):
        die("--logs has a leading wildcard: start the term with text, as host:web*")


def seconds(value, flag, low, high, text):
    n = 0 if low == 0 and re.fullmatch(r"0[smh]?", value) else parse_step(value)
    if not low <= n <= high:
        die(f"{flag} is {text} (got {value})")
    return n


def log_query(a):
    """A log rule's query model, reduce, no-data state and time range."""
    check_lucene(a.logs)
    if not a.window:
        die("--logs needs --window: how far back each evaluation counts, 5m to 60m")
    window = seconds(a.window, "--window", 300, 3600, "5m to 60m")
    delay = seconds(a.delay or "1m", "--delay", 0, 900, "0m to 15m")
    interval = a.hist or "1m"
    bucket = parse_step(interval)
    if len(interval) > SHOWN_MAX or window > bucket * BUCKETS_MAX:
        die(f"--hist {interval} divides --window {a.window} into too many: at most "
            f"{BUCKETS_MAX} buckets")
    spec = a.metric or "count"
    kind, colon, field = spec.partition(":")
    if kind not in LOG_METRICS:
        die(f"--metric {spec!r}: use count, sum:F, avg:F, max:F or min:F")
    if kind == "count" and colon:
        die(f"--metric {spec!r}: count takes no field")
    field = None if kind == "count" else field_arg(field, f"--metric {spec!r}")
    tf = None if a.time_field is None else field_arg(a.time_field, "--time-field")
    reducer, quiet = LOG_METRICS[kind]
    # No matching documents is normal for a count or sum: it means zero.
    no_data = ("OK" if a.op == "gt" else "Alerting") if quiet == "0" else "NoData"
    # The counted span is the window, ending the delay ago.
    return (log_model(a.logs, kind, field, interval, tf, tf), reducer, no_data,
            {"from": window + delay, "to": delay})


def log_model(query, kind, field, interval, time_field, bucket_field):
    metric = {"id": "1", "type": kind}
    hist = {"id": "2", "type": "date_histogram",
            "settings": {"interval": interval, "min_doc_count": LOG_METRICS[kind][1]}}
    model = {"refId": "A", "queryType": "lucene", "query": query, "metrics": [metric],
             "bucketAggs": [hist]}
    for holder, key, value in ((metric, "field", field), (model, "timeField", time_field),
                               (hist, "field", bucket_field)):
        if value is not None:
            holder[key] = value
    return model


def group_interval(folder, group):
    data = send("list_alert_rule_states", None, f"folder_uid={folder}")
    for g in ((data or {}).get("data") or {}).get("groups") or []:
        if isinstance(g, dict) and g.get("name") == group:
            return g.get("interval")


def steps(ds, query, reducer, rng, op, thr):
    """The three-step query model: one data source query, reduce, threshold."""
    def step(ref, dsu, model):
        return {"refId": ref, "datasourceUid": dsu, "queryType": "",
                "relativeTimeRange": dict(rng), "model": model}
    def cond(ref, ty, params):
        return {"evaluator": {"params": params, "type": ty}, "operator": {"type": "and"},
                "query": {"params": [ref]}, "reducer": {"params": [], "type": "last"},
                "type": "query"}
    x = {"type": "__expr__", "uid": "__expr__"}
    return [step("A", ds, query),
            step("B", "__expr__", {"conditions": [cond("B", "gt", [])], "datasource": x,
                                   "expression": "A", "reducer": reducer, "refId": "B",
                                   "type": "reduce"}),
            step("C", "__expr__", {"conditions": [cond("C", op, [thr])], "datasource": x,
                                   "expression": "B", "refId": "C", "type": "threshold"})]


def cmd_create(a):
    if not a.title or CTRL.search(a.title):
        die("--title is one line of text")
    if a.expr is not None and a.logs is not None:
        die("pass --expr or --logs, not both: a rule is one query")
    if a.expr is None and a.logs is None:
        die("create needs --expr or --logs")
    if a.logs is not None:
        kind, (query, reducer, no_data, rng) = "logs", log_query(a)
    else:
        if any(v is not None for v in (a.window, a.metric, a.hist, a.delay, a.time_field)):
            die("--window, --metric, --hist, --delay and --time-field go with --logs")
        kind, reducer, no_data = "prometheus", "last", "NoData"
        rng = {"from": check_expr(a.expr), "to": 0}
        query = {"editorMode": "code", "expr": a.expr, "instant": True, "legendFormat": "__auto",
                 "refId": "A"}
    for_s = parse_step(a.for_)
    if for_s < MIN_FOR_S:
        die(f"--for is at least 2 minutes (got {a.for_})")
    exp = (today() + dt.timedelta(days=days_of(a.expires))).isoformat()
    check_ds(a.ds, kind)
    check_receiver(a.receiver)
    rules = mine(a.managed_by, a.folder)
    if len(rules) >= FOLDER_CAP:
        have = ", ".join(f"{r.get('uid')} ({r.get('title')})" for r in rules)
        die(f"{a.managed_by} already manages {FOLDER_CAP} rules in folder {a.folder}: expire or "
            f"delete one first. Managed: {have}")
    if a.service and len([r for r in rules
                          if (r.get("labels") or {}).get("service") == a.service]) >= SERVICE_CAP:
        die(f"service {a.service} already has {SERVICE_CAP} managed rules here: expire or delete one")
    gi = group_interval(a.folder, a.group)
    if gi is not None and gi < MIN_EVAL_S:
        die(f"rule group {a.group} evaluates every {gi}s: managed rules evaluate no more often "
            "than every minute")
    labels = {"managed_by": a.managed_by, "expires": exp}
    if a.service:
        labels["service"] = a.service
    body = {"orgID": send("get_current_org", None)["id"], "title": a.title, "ruleGroup": a.group,
            "folderUID": a.folder, "condition": "C",
            "data": steps(a.ds, query, reducer, rng, a.op, a.threshold), "for": f"{for_s}s",
            "noDataState": no_data, "execErrState": "Error", "isPaused": False, "labels": labels,
            "annotations": {"summary": a.title, "expires": exp},
            "notification_settings": {"receiver": a.receiver}}
    if a.print_body:
        print("# body: " + json.dumps(body, separators=(",", ":")))
    r = send("create_alert_rule", body)
    print(f"created {clean(a.title)!r} (uid {clean(r.get('uid')) if isinstance(r, dict) else '?'}), "
          f"expires {exp}; held for approval")


def read_managed(a):
    """The rule behind a.uid; refuses anything the agent does not manage."""
    if not UID_RE.match(a.uid or "") or len(a.uid) > 40:
        die("the rule uid is 1 to 40 letters, digits, dashes or underscores")
    rule = send("get_alert_rule", None, f"uid={a.uid}")
    if not isinstance(rule, dict) or (rule.get("labels") or {}).get("managed_by") != a.managed_by:
        die(f"rule {a.uid} is missing or not managed by {a.managed_by!r}: a rule without the "
            "agent's managed_by label belongs to a person")
    if rule.get("folderUID") != a.folder:
        die(f"rule {a.uid} is in folder {clean(rule.get('folderUID'))}, not {a.folder}: the agent "
            "only touches rules in its own folder")
    return rule


SHAPE_LABELS = {"managed_by", "expires", "service"}
SHAPE_ANNOTATIONS = {"summary", "expires"}
PROM_KEYS = {"editorMode", "expr", "instant", "legendFormat", "refId"}


def query_model(rule):
    """The first step's query model without what the server adds to every stored one."""
    data = rule.get("data") or [{}]
    m = data[0].get("model") if isinstance(data[0], dict) else None
    return {k: v for k, v in m.items() if k not in STEP_STRIP} if isinstance(m, dict) else {}


def rule_kind(model):
    """`prometheus`, or `logs` when the script would build this very model from its values."""
    if "expr" in model and set(model) <= PROM_KEYS:
        expr = model["expr"]
        return "prometheus" if isinstance(expr, str) and len(expr) <= SHOWN_MAX else None
    try:
        (m,), (b,) = model["metrics"], model["bucketAggs"]
        values = (model["query"], m["type"], m.get("field"), b["settings"]["interval"],
                  model.get("timeField"), b.get("field"))
        if model == log_model(*values) and all(len(str(v)) <= SHOWN_MAX for v in values):
            return "logs"
    except (KeyError, TypeError, ValueError, AttributeError):
        pass


def check_shape(rule):
    """Refuses a rule that left the shape the script builds; it is never resent."""
    why = (rule.get("record") is not None and "a recording rule (`record`)"
           or len(rule.get("data") or []) != 3
           and "not the script's one query with its reduce and threshold"
           or set(rule.get("notification_settings") or {}) - {"receiver"}
           and "a notification_settings key other than receiver"
           or set(rule.get("labels") or {}) - SHAPE_LABELS
           and "a label other than managed_by, expires and service"
           or set(rule.get("annotations") or {}) - SHAPE_ANNOTATIONS
           and "an annotation other than summary and expires")
    if why:
        die(f"the rule carries {why}: the script resends only the shape it builds — a second query "
            "or a recording rule would run on every evaluation, and another label could be what a "
            "notification policy matches")
    model = query_model(rule)
    if not rule_kind(model) and "expr" in model and set(model) <= PROM_KEYS:
        die(f"the rule's expression is not a text of at most {SHOWN_MAX} characters, which an "
            "approval can show in full: delete it and create it again with a shorter one")
    if not rule_kind(model):
        die("the script resends only one Prometheus query, or one OpenSearch log query as it "
            f"builds it (texts up to {SHOWN_MAX} characters); the rule's query model is "
            f"{json.dumps(model, sort_keys=True)[:600]}")


def expiry_of(rule):
    """The expiry, read from the `expires` label only; the annotation is a copy for people.

    The script writes both the same, so a rule whose copies disagree was changed outside it
    and the label may no longer be the truth; such a rule is refused.
    """
    lab = (rule.get("labels") or {}).get("expires")
    ann = (rule.get("annotations") or {}).get("expires")
    if lab and ann and lab != ann:
        die(f"the expires label ({clean(lab)}) and the expires annotation ({clean(ann)}) disagree: "
            "the script writes both, so the rule was changed outside it; fix or delete the rule in "
            "Grafana")
    return as_date(lab) if lab else None


def apply_change(rule, a):
    """The rule's body with the asked changes; an expiry extension needs --renew."""
    check_shape(rule)
    # A newer server answers every rule with `record: null`, which is not sent back.
    body = {k: v for k, v in rule.items() if k not in STRIP and not (k == "record" and v is None)}
    for s in body.get("data") or []:
        m = s.get("model") if isinstance(s, dict) else None
        if isinstance(m, dict):
            for k in STEP_STRIP: m.pop(k, None)
    old = expiry_of(rule)
    if a.expires:
        exp = (today() + dt.timedelta(days=days_of(a.expires))).isoformat()
        if old is None:
            # No readable expiry: setting one may be extending how long the rule lives after all.
            if not (a.renew and (a.reason or "").strip()):
                die("the rule has no readable expiry: setting one may extend how long it lives, "
                    "so pass --renew with --reason")
        elif exp > old.isoformat():
            if not a.renew:
                die(f"--expires {a.expires} extends the expiry from {old.isoformat()} to {exp}: "
                    "pass --renew with --reason")
            if not (a.reason or "").strip():
                die("--renew needs --reason: why the rule should live longer")
        rule.setdefault("labels", {})["expires"] = exp
        if "expires" in (rule.get("annotations") or {}):
            rule["annotations"]["expires"] = exp
    if a.title:
        body["title"] = body.setdefault("annotations", {})["summary"] = a.title
    if a.for_:
        if parse_step(a.for_) < MIN_FOR_S:
            die(f"--for is at least 2 minutes (got {a.for_})")
        body["for"] = f"{parse_step(a.for_)}s"
    if a.receiver:
        check_receiver(a.receiver)
        body.setdefault("notification_settings", {})["receiver"] = a.receiver
    if not (body.get("notification_settings") or {}).get("receiver"):
        die("the rule names no receiver: pass --receiver with a contact point a person made")
    return body


def cmd_update(a):
    rule = read_managed(a)
    send("update_alert_rule", apply_change(rule, a), f"uid={a.uid}")
    print(f"changed {clean(rule.get('title'))!r} (uid {a.uid}); held for approval")


def cmd_delete(a):
    rule = read_managed(a)
    print(f"deleting {clean(rule.get('title'))!r} (uid {a.uid}, expires "
          f"{clean((rule.get('labels') or {}).get('expires'))})")
    send("delete_alert_rule", None, f"uid={a.uid}")
    print(f"deleted {a.uid}; the delete was held for approval")


def cmd_expire(a):
    rules, now, due = mine(a.managed_by, a.folder), today(), []
    for r in rules:
        d = expiry_of(r)
        if d and d < now:
            due.append(r)
    if not due:
        print(f"nothing expired: {len(rules)} managed rule(s), none past its expiry")
        return 0
    for r in due:
        print(f"deleting {clean(r.get('title'))!r} (uid {clean(r.get('uid'))}, expired "
              f"{clean((r.get('labels') or {}).get('expires'))})")
        send("delete_alert_rule", None, f"uid={r.get('uid')}")
    print(f"{len(due)} deleted, {len(rules) - len(due)} left; each delete was held for approval")


def cmd_list(a):
    print("uid\ttitle\tgroup\tkind\texpiry")
    for r in mine(a.managed_by, a.folder):
        print("\t".join(clean(x) for x in (r.get("uid"), r.get("title"), r.get("ruleGroup"),
              rule_kind(query_model(r)) or "?", (r.get("labels") or {}).get("expires") or "?")))


def main():
    ap = argparse.ArgumentParser(prog="grafana-alert")
    ap.add_argument("cmd", choices=("create", "list", "update", "delete", "expire"))
    ap.add_argument("uid", nargs="?")
    for f in ("--managed-by --folder --group --title --ds --expr --logs --metric --window --hist "
              "--delay --time-field --op --threshold --for --receiver --expires --service "
              "--print-body --renew --reason").split():
        d = f[2:].replace("-", "_") + ("_" if f == "--for" else "")
        kw = ({"action": "store_true"} if f in ("--print-body", "--renew") else
              {"type": float} if f == "--threshold" else
              {"choices": ("gt", "lt")} if f == "--op" else {})
        ap.add_argument(f, dest=d, **kw)
    a = ap.parse_args()
    need = {"create": "managed-by folder group title ds op threshold for receiver expires",
            "update": "uid managed-by folder", "delete": "uid managed-by folder",
            "list": "managed-by", "expire": "managed-by folder"}[a.cmd]
    for f in need.split():
        v = a.uid if f == "uid" else getattr(a, f.replace("-", "_") + ("_" if f == "for" else ""))
        if v is None or (f == "uid" and not v):
            die(f"{a.cmd} needs --{f}")
    sys.exit({"create": cmd_create, "list": cmd_list, "update": cmd_update,
              "delete": cmd_delete, "expire": cmd_expire}[a.cmd](a))


if __name__ == "__main__":
    main()
