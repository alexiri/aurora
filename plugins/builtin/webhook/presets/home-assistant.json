        "type": "json",
        "required": true,
        "description": "The JSON object the automation's webhook trigger receives (available as trigger.json)."
      }
    ],
    "headers": [],
    "description": "",
    "signing": false,
    "rate": { "per_minute": null, "per_day": null },
    "preset": "home-assistant"
  }
}
