#!/bin/sh
# `goose` in the web terminal (P5-HARN, C-1015, docs/12 §Terminal); see `claude` and `codex` beside it.
# goose is configured by environment (the same variables `goose::config::build_env` sets for a turn),
# keeps all of its state under /workspace/.aurora/terminal/goose (GOOSE_PATH_ROOT; never the agent
# harness's), and stays off the vendor network and its own keyring. Like `claude`, it reads
# /run/aurora/harness.env as data, never as shell (FIX-155), and runs its helpers by absolute path.
bin=/opt/aurora/harness/goose/goose
envfile=/run/aurora/harness.env
readonly bin envfile
refuse() {
    echo "goose: not enabled on this instance" >&2
    exit 127
}
[ -x "$bin" ] || refuse
if [ ! -r "$envfile" ]; then
    echo "goose: the sandbox's gateway settings ($envfile) are missing" >&2
    exit 1
fi
bad() {
    echo "goose: $envfile is not in the expected format" >&2
    exit 1
}
# Read the file once, then parse that copy twice (check, then export), so a file with any bad line
# applies nothing. Accepted lines: blank, `# ...`, and NAME='VALUE' (NAME matches
# [A-Za-z_][A-Za-z0-9_]*; VALUE is one single-quoted word, an embedded quote written as the four
# characters '\'' ; nothing after the closing quote).
_w_all=
while IFS= read -r _w_line || [ -n "$_w_line" ]; do
    _w_all="$_w_all$_w_line
"
done <"$envfile"
_w_sq="'"
_w_esc="\\$_w_sq$_w_sq"
load_env() {
    while IFS= read -r _w_line; do
        case $_w_line in
        "" | "#"*) continue ;;
        *=*) ;;
        *) bad ;;
        esac
        _w_name=${_w_line%%=*}
        case $_w_name in
        "" | [0-9]* | *[!A-Za-z0-9_]*) bad ;;
        esac
        _w_rest=${_w_line#*=}
        case $_w_rest in
        "$_w_sq"*) _w_rest=${_w_rest#"$_w_sq"} ;;
        *) bad ;;
        esac
        _w_val=
        while :; do
            case $_w_rest in
            *"$_w_sq"*) ;;
            *) bad ;;
            esac
            _w_val=$_w_val${_w_rest%%"$_w_sq"*}
            _w_rest=${_w_rest#*"$_w_sq"}
            case $_w_rest in
            "") break ;;
            "$_w_esc"*)
                _w_val=$_w_val$_w_sq
                _w_rest=${_w_rest#"$_w_esc"}
                ;;
            *) bad ;;
            esac
        done
        if [ "$1" = apply ]; then
            export "$_w_name=$_w_val"
        fi
    done <<EOF
$_w_all
EOF
}
load_env check
load_env apply
case " ${HARNESSES_ENABLED:-} " in
*" goose "*) ;;
*) refuse ;;
esac
# No usable model for this agent (C-750 (4)): say why instead of calling a host with no credential.
if [ -n "${AURORA_GOOSE_UNAVAILABLE:-}" ]; then
    echo "goose: $AURORA_GOOSE_UNAVAILABLE" >&2
    exit 1
fi
GOOSE_PATH_ROOT=/workspace/.aurora/terminal/goose
export GOOSE_PATH_ROOT
/usr/bin/mkdir -p "$GOOSE_PATH_ROOT" 2>/dev/null
model="${AURORA_GOOSE_MODEL:-}"
provider="${AURORA_GOOSE_PROVIDER:-}"
host="${AURORA_GOOSE_HOST:-}"
# goose uses none of the other harnesses' variables.
unset HARNESSES_ENABLED AURORA_GOOSE_MODEL AURORA_GOOSE_PROVIDER AURORA_GOOSE_HOST AURORA_GOOSE_UNAVAILABLE \
    AURORA_CLAUDE_UNAVAILABLE AURORA_CODEX_UNAVAILABLE AURORA_CODEX_MODEL AURORA_CODEX_BASE_URL \
    ANTHROPIC_MODEL ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY
# No telemetry, no keyring, no session-naming request; instructions from AGENTS.md; the gateway CA.
GOOSE_TELEMETRY_ENABLED=false
GOOSE_DISABLE_KEYRING=1
GOOSE_DISABLE_SESSION_NAMING=true
CONTEXT_FILE_NAMES='["AGENTS.md"]'
export GOOSE_TELEMETRY_ENABLED GOOSE_DISABLE_KEYRING GOOSE_DISABLE_SESSION_NAMING CONTEXT_FILE_NAMES
if [ -n "${SSL_CERT_FILE:-}" ]; then
    GOOSE_CA_CERT_PATH=$SSL_CERT_FILE
    export GOOSE_CA_CERT_PATH
fi
if [ -n "$model" ] && [ -n "$host" ]; then
    GOOSE_MODEL=$model
    export GOOSE_MODEL
    case $provider in
    anthropic)
        GOOSE_PROVIDER=anthropic
        ANTHROPIC_HOST=$host
        ANTHROPIC_API_KEY=aurora-placeholder
        export GOOSE_PROVIDER ANTHROPIC_HOST ANTHROPIC_API_KEY
        ;;
    litellm)
        GOOSE_PROVIDER=litellm
        LITELLM_HOST=$host
        LITELLM_BASE_PATH=v1/chat/completions
        LITELLM_API_KEY=aurora-placeholder
        export GOOSE_PROVIDER LITELLM_HOST LITELLM_BASE_PATH LITELLM_API_KEY
        ;;
    *)
        echo "goose: the agent's model endpoint cannot be used with goose" >&2
        exit 1
        ;;
    esac
fi
exec "$bin" "$@"
