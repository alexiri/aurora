#!/bin/sh
# `claude` in the web terminal (FIX-138 item 1b, docs/12 §Terminal). The agent's harness runs the
# pinned CLI from the supervisor; a person in the terminal gets it through this wrapper, which
#   - refuses when the harness is not in the image or not enabled on this instance,
#   - reads /run/aurora/harness.env as DATA (written by the supervisor: the machine proxy, the
#     gateway CA, the placeholder credential the gateway replaces, the agent's model; no secret).
#     It is never run as shell (FIX-155): the file is agent-writable at one uid, so a line that is
#     not `NAME='VALUE'` makes the wrapper refuse to start instead of executing it. This is not a
#     security boundary: the terminal is the agent's own environment (docs/17 residual),
#   - keeps its own state in /workspace/.aurora/terminal/claude (never the agent harness's), and
#   - execs the pinned binary. Its own helpers are absolute paths, not resolved through PATH.
bin=/opt/aurora/harness/claude-code/node_modules/.bin/claude
envfile=/run/aurora/harness.env
readonly bin envfile
refuse() {
    echo "claude: not enabled on this instance" >&2
    exit 127
}
[ -x "$bin" ] || refuse
if [ ! -r "$envfile" ]; then
    echo "claude: the sandbox's gateway settings ($envfile) are missing" >&2
    exit 1
fi
bad() {
    echo "claude: $envfile is not in the expected format" >&2
    exit 1
}
# Read the file once, then parse that copy twice: the first pass only checks every line, the second
# exports, so a file with any bad line applies nothing. Accepted lines: blank, `# ...`, and
# NAME='VALUE' (NAME matches [A-Za-z_][A-Za-z0-9_]*; VALUE is one single-quoted word, an embedded
# quote written as the four characters '\'' ; nothing after the closing quote).
_w_all=
while IFS= read -r _w_line || [ -n "$_w_line" ]; do
    _w_all="$_w_all$_w_line
"
done <"$envfile"
_w_sq="'"
_w_esc="\\$_w_sq$_w_sq"
load_env() {
    while IFS= read -r _w_line; do
        case $_w_line in
        "" | "#"*) continue ;;
        *=*) ;;
        *) bad ;;
        esac
        _w_name=${_w_line%%=*}
        case $_w_name in
        "" | [0-9]* | *[!A-Za-z0-9_]*) bad ;;
        esac
        _w_rest=${_w_line#*=}
        case $_w_rest in
        "$_w_sq"*) _w_rest=${_w_rest#"$_w_sq"} ;;
        *) bad ;;
        esac
        _w_val=
        while :; do
            case $_w_rest in
            *"$_w_sq"*) ;;
            *) bad ;;
            esac
            _w_val=$_w_val${_w_rest%%"$_w_sq"*}
            _w_rest=${_w_rest#*"$_w_sq"}
            case $_w_rest in
            "") break ;;
            "$_w_esc"*)
                _w_val=$_w_val$_w_sq
                _w_rest=${_w_rest#"$_w_esc"}
                ;;
            *) bad ;;
            esac
        done
        if [ "$1" = apply ]; then
            export "$_w_name=$_w_val"
        fi
    done <<EOF
$_w_all
EOF
}
load_env check
load_env apply
case " ${HARNESSES_ENABLED:-} " in
*" claude-code "*) ;;
*) refuse ;;
esac
# No usable model for this agent (C-750 (4)): say why instead of calling a host with no credential.
if [ -n "${AURORA_CLAUDE_UNAVAILABLE:-}" ]; then
    echo "claude: $AURORA_CLAUDE_UNAVAILABLE" >&2
    exit 1
fi
unset HARNESSES_ENABLED AURORA_CLAUDE_UNAVAILABLE AURORA_CODEX_UNAVAILABLE \
    AURORA_CODEX_MODEL AURORA_CODEX_BASE_URL
CLAUDE_CONFIG_DIR=/workspace/.aurora/terminal/claude
export CLAUDE_CONFIG_DIR
/usr/bin/mkdir -p "$CLAUDE_CONFIG_DIR" 2>/dev/null
# (FIX-169, D-371, C-1025) The same default as a turn (`--permission-mode bypassPermissions`,
# adapters/claude_code/config.rs): the Aurora sandbox and gateway are the boundary, not the CLI's
# per-action prompts. It is only a default: a person who passes a mode (either spelling), or
# --dangerously-skip-permissions / --allow-dangerously-skip-permissions, keeps exactly that, with no
# second mode added. A root flag placed before a subcommand is accepted by every subcommand
# (`claude --permission-mode bypassPermissions mcp list`, `--version`, `doctor`, `update`), so the
# default needs no subcommand special case. The person's settings.json is never touched.
_w_default=1
for _w_arg in "$@"; do
    case $_w_arg in
    --) break ;;
    --permission-mode | --permission-mode=* | --dangerously-skip-permissions | --allow-dangerously-skip-permissions)
        _w_default=0
        break
        ;;
    esac
done
if [ "$_w_default" = 1 ]; then
    exec "$bin" --permission-mode bypassPermissions "$@"
fi
exec "$bin" "$@"
