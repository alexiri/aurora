#!/bin/sh
# `opencode` in the web terminal (P5-HARN, C-1015, docs/12 §Terminal); see `claude` and `codex` beside
# it. OpenCode takes its provider from its config, which the wrapper passes inline
# (OPENCODE_CONFIG_CONTENT = AURORA_OPENCODE_CONFIG, the same values `opencode::config` writes for a
# turn, without the platform tools), keeps its state under /workspace/.aurora/terminal/opencode (never
# the agent harness's) and keeps it off the vendor network. Like `claude`, it reads
# /run/aurora/harness.env as data, never as shell (FIX-155), and runs its helpers by absolute path.
bin=/opt/aurora/harness/opencode/opencode
envfile=/run/aurora/harness.env
readonly bin envfile
refuse() {
    echo "opencode: not enabled on this instance" >&2
    exit 127
}
[ -x "$bin" ] || refuse
if [ ! -r "$envfile" ]; then
    echo "opencode: the sandbox's gateway settings ($envfile) are missing" >&2
    exit 1
fi
bad() {
    echo "opencode: $envfile is not in the expected format" >&2
    exit 1
}
# Read the file once, then parse that copy twice (check, then export), so a file with any bad line
# applies nothing. Accepted lines: blank, `# ...`, and NAME='VALUE' (NAME matches
# [A-Za-z_][A-Za-z0-9_]*; VALUE is one single-quoted word, an embedded quote written as the four
# characters '\'' ; nothing after the closing quote).
_w_all=
while IFS= read -r _w_line || [ -n "$_w_line" ]; do
    _w_all="$_w_all$_w_line
"
done <"$envfile"
_w_sq="'"
_w_esc="\\$_w_sq$_w_sq"
load_env() {
    while IFS= read -r _w_line; do
        case $_w_line in
        "" | "#"*) continue ;;
        *=*) ;;
        *) bad ;;
        esac
        _w_name=${_w_line%%=*}
        case $_w_name in
        "" | [0-9]* | *[!A-Za-z0-9_]*) bad ;;
        esac
        _w_rest=${_w_line#*=}
        case $_w_rest in
        "$_w_sq"*) _w_rest=${_w_rest#"$_w_sq"} ;;
        *) bad ;;
        esac
        _w_val=
        while :; do
            case $_w_rest in
            *"$_w_sq"*) ;;
            *) bad ;;
            esac
            _w_val=$_w_val${_w_rest%%"$_w_sq"*}
            _w_rest=${_w_rest#*"$_w_sq"}
            case $_w_rest in
            "") break ;;
            "$_w_esc"*)
                _w_val=$_w_val$_w_sq
                _w_rest=${_w_rest#"$_w_esc"}
                ;;
            *) bad ;;
            esac
        done
        if [ "$1" = apply ]; then
            export "$_w_name=$_w_val"
        fi
    done <<EOF
$_w_all
EOF
}
load_env check
load_env apply
case " ${HARNESSES_ENABLED:-} " in
*" opencode "*) ;;
*) refuse ;;
esac
# No usable model for this agent (C-750 (4)): say why instead of calling a host with no credential.
if [ -n "${AURORA_OPENCODE_UNAVAILABLE:-}" ]; then
    echo "opencode: $AURORA_OPENCODE_UNAVAILABLE" >&2
    exit 1
fi
_w_state=/workspace/.aurora/terminal/opencode
/usr/bin/mkdir -p "$_w_state" 2>/dev/null
XDG_CONFIG_HOME=$_w_state/config
XDG_DATA_HOME=$_w_state/data
XDG_CACHE_HOME=$_w_state/cache
XDG_STATE_HOME=$_w_state/state
export XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME
config="${AURORA_OPENCODE_CONFIG:-}"
key_var="${AURORA_OPENCODE_KEY_VAR:-}"
plugin_version="${AURORA_OPENCODE_PLUGIN_VERSION:-}"
# OpenCode uses none of the other harnesses' variables.
unset HARNESSES_ENABLED AURORA_OPENCODE_MODEL AURORA_OPENCODE_CONFIG AURORA_OPENCODE_KEY_VAR \
    AURORA_OPENCODE_PLUGIN_VERSION \
    AURORA_OPENCODE_UNAVAILABLE AURORA_CLAUDE_UNAVAILABLE AURORA_CODEX_UNAVAILABLE \
    AURORA_CODEX_MODEL AURORA_CODEX_BASE_URL \
    ANTHROPIC_MODEL ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY
# No model catalogue fetch, no default plugins, no LSP download, no auto-update, no CLAUDE.md.
OPENCODE_DISABLE_MODELS_FETCH=1
OPENCODE_DISABLE_DEFAULT_PLUGINS=1
OPENCODE_DISABLE_LSP_DOWNLOAD=1
OPENCODE_DISABLE_AUTOUPDATE=1
OPENCODE_DISABLE_CLAUDE_CODE=1
export OPENCODE_DISABLE_MODELS_FETCH OPENCODE_DISABLE_DEFAULT_PLUGINS OPENCODE_DISABLE_LSP_DOWNLOAD \
    OPENCODE_DISABLE_AUTOUPDATE OPENCODE_DISABLE_CLAUDE_CODE
if [ -n "$config" ]; then
    # The configuration names the placeholder through `{env:NAME}`, resolved from this environment.
    case $key_var in
    ANTHROPIC_API_KEY) ANTHROPIC_API_KEY=aurora-placeholder && export ANTHROPIC_API_KEY ;;
    *) OPENAI_API_KEY=aurora-placeholder && export OPENAI_API_KEY ;;
    esac
    OPENCODE_CONFIG_CONTENT=$config
    export OPENCODE_CONFIG_CONTENT
fi
# (FIX-191) The files a turn renders (`opencode::config::plugin_files`) so that OpenCode's background
# install of its plugin package returns at once instead of asking the npm registry. Each is written
# only when missing: a person who adds plugins changes them, and OpenCode keeps them up to date.
write_missing() {
    if [ -e "$1" ] || [ -L "$1" ]; then
        return 0
    fi
    /usr/bin/mkdir -p "${1%/*}" 2>/dev/null || return 0
    printf '%s\n' "$2" >"$1" 2>/dev/null
}
case $plugin_version in
"" | *[!0-9A-Za-z.+-]*) ;;
*)
    _w_cfg=$XDG_CONFIG_HOME/opencode
    write_missing "$_w_cfg/package.json" \
        "{\"dependencies\":{\"@opencode-ai/plugin\":\"$plugin_version\"}}"
    write_missing "$_w_cfg/package-lock.json" \
        "{\"name\":\"opencode\",\"lockfileVersion\":3,\"requires\":true,\"packages\":{\"\":{\"dependencies\":{\"@opencode-ai/plugin\":\"$plugin_version\"}}}}"
    write_missing "$_w_cfg/node_modules/@opencode-ai/plugin/package.json" \
        "{\"name\":\"@opencode-ai/plugin\",\"version\":\"$plugin_version\"}"
    ;;
esac
# (FIX-191) Run OpenCode as a child, not `exec`, so that a start that fails behind its full-screen
# interface still says where its log is (the log is the only place its error goes).
"$bin" "$@"
_w_rc=$?
if [ "$_w_rc" -ne 0 ] && [ -d "$XDG_DATA_HOME/opencode/log" ]; then
    echo "opencode: exited with status $_w_rc; see $XDG_DATA_HOME/opencode/log for details" >&2
fi
exit "$_w_rc"
