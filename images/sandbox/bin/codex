#!/bin/sh
# `codex` in the web terminal (FIX-138 item 1b, docs/12 §Terminal); see `claude` beside it. Codex
# takes its model provider from its config, so the wrapper gives it the gateway endpoint as `-c`
# overrides (the same values `codex::config::render_config` writes for a turn) and keeps its state
# in /workspace/.aurora/terminal/codex (never the agent harness's CODEX_HOME). Like `claude`, it
# reads /run/aurora/harness.env as data, never as shell (FIX-155), and runs its helpers by
# absolute path.
bin=/opt/aurora/harness/codex/codex
envfile=/run/aurora/harness.env
readonly bin envfile
refuse() {
    echo "codex: not enabled on this instance" >&2
    exit 127
}
[ -x "$bin" ] || refuse
if [ ! -r "$envfile" ]; then
    echo "codex: the sandbox's gateway settings ($envfile) are missing" >&2
    exit 1
fi
bad() {
    echo "codex: $envfile is not in the expected format" >&2
    exit 1
}
# Read the file once, then parse that copy twice (check, then export), so a file with any bad line
# applies nothing. Accepted lines: blank, `# ...`, and NAME='VALUE' (NAME matches
# [A-Za-z_][A-Za-z0-9_]*; VALUE is one single-quoted word, an embedded quote written as the four
# characters '\'' ; nothing after the closing quote).
_w_all=
while IFS= read -r _w_line || [ -n "$_w_line" ]; do
    _w_all="$_w_all$_w_line
"
done <"$envfile"
_w_sq="'"
_w_esc="\\$_w_sq$_w_sq"
load_env() {
    while IFS= read -r _w_line; do
        case $_w_line in
        "" | "#"*) continue ;;
        *=*) ;;
        *) bad ;;
        esac
        _w_name=${_w_line%%=*}
        case $_w_name in
        "" | [0-9]* | *[!A-Za-z0-9_]*) bad ;;
        esac
        _w_rest=${_w_line#*=}
        case $_w_rest in
        "$_w_sq"*) _w_rest=${_w_rest#"$_w_sq"} ;;
        *) bad ;;
        esac
        _w_val=
        while :; do
            case $_w_rest in
            *"$_w_sq"*) ;;
            *) bad ;;
            esac
            _w_val=$_w_val${_w_rest%%"$_w_sq"*}
            _w_rest=${_w_rest#*"$_w_sq"}
            case $_w_rest in
            "") break ;;
            "$_w_esc"*)
                _w_val=$_w_val$_w_sq
                _w_rest=${_w_rest#"$_w_esc"}
                ;;
            *) bad ;;
            esac
        done
        if [ "$1" = apply ]; then
            export "$_w_name=$_w_val"
        fi
    done <<EOF
$_w_all
EOF
}
load_env check
load_env apply
case " ${HARNESSES_ENABLED:-} " in
*" codex "*) ;;
*) refuse ;;
esac
# No usable model for this agent (C-750 (4)): say why instead of calling a host with no credential.
if [ -n "${AURORA_CODEX_UNAVAILABLE:-}" ]; then
    echo "codex: $AURORA_CODEX_UNAVAILABLE" >&2
    exit 1
fi
CODEX_HOME=/workspace/.aurora/terminal/codex
export CODEX_HOME
/usr/bin/mkdir -p "$CODEX_HOME" 2>/dev/null
model="${AURORA_CODEX_MODEL:-}"
base="${AURORA_CODEX_BASE_URL:-}"
# Codex uses none of the Claude Code variables.
unset HARNESSES_ENABLED AURORA_CODEX_MODEL AURORA_CODEX_BASE_URL \
    AURORA_CLAUDE_UNAVAILABLE AURORA_CODEX_UNAVAILABLE \
    ANTHROPIC_MODEL ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY
# (FIX-169, D-371, C-1025) The same approval and sandbox settings as a turn (adapters/codex/config.rs):
# Codex's own sandbox cannot nest in the container, and the Aurora sandbox and gateway are the
# boundary. They are defaults placed before the person's arguments: a later `-c` of theirs wins, and
# a dedicated flag (-a/--ask-for-approval, -s/--sandbox, --full-auto,
# --dangerously-bypass-approvals-and-sandbox) means we add neither the approval nor the sandbox default
# it covers.
_w_ask=1
_w_box=1
for _w_arg in "$@"; do
    case $_w_arg in
    --) break ;;
    -a | --ask-for-approval | --ask-for-approval=*) _w_ask=0 ;;
    -s | --sandbox | --sandbox=*) _w_box=0 ;;
    --full-auto | --dangerously-bypass-approvals-and-sandbox)
        _w_ask=0
        _w_box=0
        ;;
    esac
done
[ "$_w_box" = 1 ] && set -- -c 'sandbox_mode="danger-full-access"' "$@"
[ "$_w_ask" = 1 ] && set -- -c 'approval_policy="never"' "$@"
if [ -n "$base" ]; then
    # TOML basic strings: the values come from the supervisor (an endpoint URL, a model id).
    exec "$bin" \
        -c "model_provider=\"aurora\"" \
        -c "model=\"$model\"" \
        -c "model_providers.aurora.name=\"Aurora gateway\"" \
        -c "model_providers.aurora.base_url=\"$base\"" \
        -c "model_providers.aurora.wire_api=\"responses\"" \
        -c "model_providers.aurora.env_key=\"OPENAI_API_KEY\"" \
        -c "model_providers.aurora.requires_openai_auth=false" \
        -c "check_for_update_on_startup=false" \
        -c "forced_login_method=\"api\"" \
        "$@"
fi
exec "$bin" -c "check_for_update_on_startup=false" "$@"
