# syntax=docker/dockerfile:1
# Sandbox image (docs/11 §Sandbox image).
#   podman build -f images/sandbox/Containerfile --target sandbox-min -t aurora-sandbox-min:dev .
# Targets: base (OS + tools), sandbox (base + supervisor + harness), sandbox-min (OS + supervisor, e2e).
# The public official AlmaLinux 10 image, pinned by digest, is the default; a deployment that needs
# a private or mirrored base overrides it at build time (docs/15):
#   --build-arg SANDBOX_BASE_IMAGE=<registry>/<image>:<tag>
ARG SANDBOX_BASE_IMAGE=docker.io/library/almalinux:10@sha256:5a4b41a427c9717be8f4ac2a32aa22efbae5f9124fbcb79a6765394f312acfe8

# ---- supervisor, built against an older glibc than the AlmaLinux runtime (OPS-020: cargo-chef deps
# layer + lld, same design as images/services/Containerfile; target/ stays in layers for the gha cache)
ARG RUST_IMAGE=docker.io/library/rust:1-bookworm
FROM ${RUST_IMAGE} AS chef
ARG CARGO_CHEF_VERSION=0.1.78
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends clang lld \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install cargo-chef --locked --version ${CARGO_CHEF_VERSION}
WORKDIR /build
ENV CARGO_TERM_COLOR=never CARGO_INCREMENTAL=0 RUSTFLAGS="-C link-arg=-fuse-ld=lld"

FROM chef AS planner
COPY . .
RUN rm -f rust-toolchain.toml && cargo chef prepare --recipe-path recipe.json

FROM chef AS supervisor-builder
COPY --from=planner /build/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo chef cook --release --locked --recipe-path recipe.json -p aurora-supervisor
COPY . .
RUN rm -f rust-toolchain.toml
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo build --release --locked -p aurora-supervisor \
        && mkdir /out \
        && cp target/release/aurora-supervisor /out/ \
        && cp target/release/preview-echo /out/

# ---- OS: AlmaLinux 10 with the unprivileged `agent` user and an empty /workspace
FROM ${SANDBOX_BASE_IMAGE} AS os
# `postgresql` is the psql client: `psql service=<name>` is how agents use database connections
# (P2-DBL-2; the supervisor writes the libpq service, password and CA files).
RUN dnf -y install --setopt=install_weak_deps=False shadow-utils glibc-common postgresql rpm \
    && useradd --uid 1000 --user-group --home-dir /workspace --no-create-home --shell /bin/bash agent \
    && mkdir -p /workspace /run/aurora /opt/aurora \
    && chown 1000:1000 /workspace \
    && dnf clean all && rm -rf /var/cache/dnf /var/log/dnf* /tmp/*
WORKDIR /workspace

# ---- base: developer tool set (rebuilt rarely)
FROM os AS base
RUN dnf -y install --setopt=install_weak_deps=False epel-release \
    && dnf -y install --setopt=install_weak_deps=False \
         git curl jq ripgrep fd-find less openssh-clients python3 python3-pip \
         nodejs npm gcc gcc-c++ make unzip zip procps-ng \
    && (dnf -y install --setopt=install_weak_deps=False chromium || echo "chromium unavailable") \
    && dnf clean all && rm -rf /var/cache/dnf \
    && pip3 install --no-cache-dir uv \
    && npm config set prefix /workspace/.local --global \
    # No privilege escalation or package management for the agent.
    && rm -f /usr/bin/sudo /usr/bin/su /usr/bin/dnf* /usr/bin/yum /usr/bin/rpm* 2>/dev/null; true
ENV PATH=/workspace/.local/bin:/usr/local/bin:/usr/bin:/bin
# Chromium wrapper: browsers go through the open proxy 127.0.0.1:3129, which exists only when the
# sandbox booted with the `browser` capability (RFE-003).
COPY images/sandbox/chromium-wrapper.sh /usr/local/bin/chromium-browser
RUN ln -s chromium-browser /usr/local/bin/chromium

# ---- sandbox: base + supervisor + pinned harness
FROM base AS sandbox
# (RFE-003) Capabilities this image supports; the runner reads the label at registration and the
# API starts boots with `browser` only when it is declared (docs/11 §The boot document). A custom
# image without Chromium omits it.
LABEL org.aurora.capabilities="browser"
# (phase 4, P4-HAR, D-122) Harness runtimes in this image, a comma list of `claude-code` and
# `codex`; `--build-arg SANDBOX_HARNESSES=claude-code` omits Codex (a slimmer image). The label
# `org.aurora.harnesses` tells the runner what is inside (`fake` needs no runtime); an image
# without the label is read as `claude-code,fake`.
ARG SANDBOX_HARNESSES="claude-code,codex"
LABEL org.aurora.harnesses="${SANDBOX_HARNESSES},fake"
# Pinned Claude Code CLI; must match PINNED_VERSION in
# services/aurora-supervisor/src/adapters/claude_code/mod.rs.
ARG CLAUDE_CODE_VERSION=2.1.319
RUN case ",${SANDBOX_HARNESSES}," in *,claude-code,*) \
      mkdir -p /opt/aurora/harness/claude-code \
   && npm install --prefix /opt/aurora/harness/claude-code --no-audit --no-fund \
        @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
   && /opt/aurora/harness/claude-code/node_modules/.bin/claude --version ;; esac
# Pinned OpenAI Codex CLI (release rust-v${CODEX_VERSION}, the static musl build); must match
# PINNED_VERSION in services/aurora-supervisor/src/adapters/codex/mod.rs. The archive is verified
# against the checksum below before it is unpacked; a mismatch fails the build.
ARG CODEX_VERSION=0.167.0
ARG CODEX_SHA256_X86_64=9d64836106d5b374e90ee4454c7ebcde7ca7106558bd7e41a34b9f26ebda251a
ARG CODEX_SHA256_AARCH64=843489acb4d4b1079745c36b03c5963b887b83155af208fd53584e33ee8eb281
RUN case ",${SANDBOX_HARNESSES}," in *,codex,*) \
      arch="$(uname -m)"; \
      case "$arch" in \
        x86_64) sha="${CODEX_SHA256_X86_64}" ;; \
        aarch64) sha="${CODEX_SHA256_AARCH64}" ;; \
        *) echo "no pinned Codex build for $arch" >&2; exit 1 ;; \
      esac; \
      name="codex-${arch}-unknown-linux-musl"; \
      mkdir -p /opt/aurora/harness/codex /tmp/codex-dl \
   && curl -fsSL --retry 3 -o "/tmp/codex-dl/${name}.tar.gz" \
        "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/${name}.tar.gz" \
   && echo "${sha}  /tmp/codex-dl/${name}.tar.gz" | sha256sum -c - \
   && tar -xzf "/tmp/codex-dl/${name}.tar.gz" -C /tmp/codex-dl \
   && install -m 0755 "/tmp/codex-dl/${name}" /opt/aurora/harness/codex/codex \
   && rm -rf /tmp/codex-dl \
   && test "$(/opt/aurora/harness/codex/codex --version)" = "codex-cli ${CODEX_VERSION}" ;; esac
COPY --from=supervisor-builder /out/aurora-supervisor /usr/local/bin/aurora-supervisor
# (P4-PRV-2) preview round-trip e2e: a share's start command may run `preview-echo <port>`.
COPY --from=supervisor-builder /out/preview-echo /usr/local/bin/preview-echo
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/aurora-supervisor", "run"]

# ---- sandbox-min: OS + supervisor only (e2e)
FROM os AS sandbox-min
COPY --from=supervisor-builder /out/aurora-supervisor /usr/local/bin/aurora-supervisor
# (P4-PRV-2) preview round-trip e2e: the share's start command runs `preview-echo <port>`.
COPY --from=supervisor-builder /out/preview-echo /usr/local/bin/preview-echo
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/aurora-supervisor", "run"]
