# syntax=docker/dockerfile:1
# Sandbox image (docs/11 §Sandbox image).
#   podman build -f images/sandbox/Containerfile --target sandbox-min -t aurora-sandbox-min:dev .
# Targets: base (OS + tools), sandbox (base + supervisor + harness), sandbox-min (OS + supervisor, e2e).
# The public official AlmaLinux 10 image, pinned by digest, is the default; a deployment that needs
# a private or mirrored base overrides it at build time (docs/15):
#   --build-arg SANDBOX_BASE_IMAGE=<registry>/<image>:<tag>
ARG SANDBOX_BASE_IMAGE=docker.io/library/almalinux:10@sha256:5a4b41a427c9717be8f4ac2a32aa22efbae5f9124fbcb79a6765394f312acfe8

# ---- supervisor, built against an older glibc than the AlmaLinux runtime (OPS-020: cargo-chef deps
# layer + lld, same design as images/services/Containerfile; target/ stays in layers for the gha cache)
ARG RUST_IMAGE=docker.io/library/rust:1-bookworm@sha256:ade39a710ef85f3506cffcfec3e8a24ba090badef1dff2fb798f71d878833fea
FROM ${RUST_IMAGE} AS chef
ARG CARGO_CHEF_VERSION=0.1.78
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends clang lld \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install cargo-chef --locked --version ${CARGO_CHEF_VERSION}
WORKDIR /build
ENV CARGO_TERM_COLOR=never CARGO_INCREMENTAL=0 RUSTFLAGS="-C link-arg=-fuse-ld=lld"

FROM chef AS planner
COPY . .
RUN rm -f rust-toolchain.toml && cargo chef prepare --recipe-path recipe.json

FROM chef AS supervisor-builder
COPY --from=planner /build/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo chef cook --release --locked --recipe-path recipe.json -p aurora-supervisor
COPY . .
RUN rm -f rust-toolchain.toml
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo build --release --locked -p aurora-supervisor \
        && mkdir /out \
        && cp target/release/aurora-supervisor /out/ \
        && cp target/release/preview-echo /out/

# ---- OS: AlmaLinux 10 with the unprivileged `agent` user and an empty /workspace
FROM ${SANDBOX_BASE_IMAGE} AS os
# `postgresql` is the psql client: `psql service=<name>` is how agents use database connections
# (P2-DBL-2; the supervisor writes the libpq service, password and CA files).
# (FIX-138) The web terminal's shells: bash (default, with bash-completion) and zsh, both in the
# OS layer so every target has them; `which` for the shells' `type`/completion helpers.
# (P5-FILES-1, D-316) `openssh-server` provides `/usr/libexec/openssh/sftp-server`, the binary the
# supervisor starts for a Files / SFTP session (`12 §SSH channels`: fixed path). Only that binary is
# used: `sshd` is never enabled or started (the assertion below), the sandbox gains no listener.
# (P4-SSH-2) `openssh-clients` is here too (the `base` stage had it already): the `scp` binary that a legacy
# `scp -O` runs on the remote side (`exec` of `scp -t`), also in the slim e2e image (`sandbox-min`).
RUN dnf -y install --setopt=install_weak_deps=False shadow-utils glibc-common postgresql rpm \
         bash bash-completion zsh which ncurses openssh-server openssh-clients \
    && useradd --uid 1000 --user-group --home-dir /workspace --no-create-home --shell /bin/bash agent \
    && mkdir -p /workspace /run/aurora /opt/aurora /opt/aurora/bin \
    && chown 1000:1000 /workspace \
    && test -x /usr/bin/zsh && test -x /bin/bash \
    && test -x /usr/libexec/openssh/sftp-server \
    && rm -f /etc/systemd/system/multi-user.target.wants/sshd.service \
             /etc/systemd/system/sockets.target.wants/sshd.socket \
    && ! test -e /etc/systemd/system/multi-user.target.wants/sshd.service \
    && ! test -e /etc/systemd/system/sockets.target.wants/sshd.socket \
    && ! (command -v systemctl >/dev/null && systemctl is-enabled sshd.service sshd.socket 2>/dev/null | grep -qx enabled) \
    && dnf clean all && rm -rf /var/cache/dnf /var/log/dnf* /tmp/*
# (FIX-138) One PATH for both shells, a turn and the terminal (`12 §Terminal`): the image ENV,
# /etc/profile.d/aurora.sh (bash login + interactive defaults) and /etc/zshenv + /etc/zshrc (zsh).
# System files, never the agent's home: a person's own ~/.bashrc / ~/.zshrc still wins.
ENV PATH=/workspace/.local/bin:/opt/aurora/bin:/usr/local/bin:/usr/bin:/bin
COPY images/sandbox/etc/profile.d/aurora.sh /etc/profile.d/aurora.sh
COPY images/sandbox/etc/zshenv /etc/zshenv
COPY images/sandbox/etc/zshrc /etc/zshrc
# (FIX-138 item 1b) `claude` and `codex` for the web terminal: wrappers on PATH that source
# /run/aurora/harness.env (written by the supervisor, no secret), keep their own state under
# /workspace/.aurora/terminal and exec the pinned binaries; a harness missing from the image or not
# enabled on the instance prints "not enabled on this instance".
COPY --chmod=0755 images/sandbox/bin/claude images/sandbox/bin/codex /opt/aurora/bin/
WORKDIR /workspace

# ---- base: developer tool set (rebuilt rarely)
FROM os AS base
RUN dnf -y install --setopt=install_weak_deps=False epel-release \
    && dnf -y install --setopt=install_weak_deps=False \
         git curl jq ripgrep fd-find less openssh-clients python3 python3-pip \
         nodejs npm gcc gcc-c++ make unzip zip procps-ng chromium \
    # (FIX-103) Chromium is required, not best-effort: the `sandbox` target declares the `browser`
    # capability below, and the runner schedules browser boots from that label. A build where the
    # package is unavailable fails here instead of shipping an image that advertises a browser it lacks.
    && { test -x /usr/bin/chromium-browser || test -x /usr/bin/chromium; } \
    && dnf clean all && rm -rf /var/cache/dnf \
    && pip3 install --no-cache-dir uv==0.13.8 \
    && npm config set prefix /workspace/.local --global \
    # No privilege escalation or package management for the agent.
    && rm -f /usr/bin/sudo /usr/bin/su /usr/bin/dnf* /usr/bin/yum /usr/bin/rpm* 2>/dev/null; true
# Chromium wrapper: browsers go through the open proxy 127.0.0.1:3129, which exists only when the
# sandbox booted with the `browser` capability (RFE-003).
COPY images/sandbox/chromium-wrapper.sh /usr/local/bin/chromium-browser
RUN ln -s chromium-browser /usr/local/bin/chromium

# ---- sandbox: base + supervisor + pinned harness
FROM base AS sandbox
# (RFE-003) Capabilities this image supports; the runner reads the label at registration and the
# API starts boots with `browser` only when it is declared (docs/11 §The boot document). A custom
# image without Chromium omits it.
LABEL org.aurora.capabilities="browser"
# (phase 4, P4-HAR, D-122) Harness runtimes in this image, a comma list of `claude-code` and
# `codex`, `pi`, `goose` and `opencode` (phase 5, P5-HARN, D-361); `--build-arg SANDBOX_HARNESSES=claude-code`
# omits the others (a slimmer image). The label `org.aurora.harnesses` tells the runner what is inside
# (`fake` needs no runtime); an image without the label is read as `claude-code,fake`.
ARG SANDBOX_HARNESSES="claude-code,codex,pi,goose,opencode"
LABEL org.aurora.harnesses="${SANDBOX_HARNESSES},fake"
# Pinned Claude Code CLI; must match PINNED_VERSION in
# services/aurora-supervisor/src/adapters/claude_code/mod.rs.
ARG CLAUDE_CODE_VERSION=2.1.319
# (FIX-103) The whole npm tree is pinned by images/sandbox/harness/claude-code/package-lock.json and
# installed with `npm ci` (integrity-checked); bump the version in package.json, regenerate the
# lockfile (`npm install --package-lock-only --ignore-scripts` in that directory) and PINNED_VERSION together.
COPY images/sandbox/harness/claude-code/package.json images/sandbox/harness/claude-code/package-lock.json /tmp/claude-code-pin/
RUN case ",${SANDBOX_HARNESSES}," in *,claude-code,*) \
      mkdir -p /opt/aurora/harness/claude-code \
   && cp /tmp/claude-code-pin/package.json /tmp/claude-code-pin/package-lock.json /opt/aurora/harness/claude-code/ \
   && (cd /opt/aurora/harness/claude-code && npm ci --no-audit --no-fund) \
   && test "$(/opt/aurora/harness/claude-code/node_modules/.bin/claude --version | cut -d' ' -f1)" = "${CLAUDE_CODE_VERSION}" ;; esac \
   && rm -rf /tmp/claude-code-pin
# Pinned OpenAI Codex CLI (release rust-v${CODEX_VERSION}, the static musl build); must match
# PINNED_VERSION in services/aurora-supervisor/src/adapters/codex/mod.rs. The archive is verified
# against the checksum below before it is unpacked; a mismatch fails the build.
ARG CODEX_VERSION=0.167.0
ARG CODEX_SHA256_X86_64=9d64836106d5b374e90ee4454c7ebcde7ca7106558bd7e41a34b9f26ebda251a
ARG CODEX_SHA256_AARCH64=843489acb4d4b1079745c36b03c5963b887b83155af208fd53584e33ee8eb281
RUN case ",${SANDBOX_HARNESSES}," in *,codex,*) \
      arch="$(uname -m)"; \
      case "$arch" in \
        x86_64) sha="${CODEX_SHA256_X86_64}" ;; \
        aarch64) sha="${CODEX_SHA256_AARCH64}" ;; \
        *) echo "no pinned Codex build for $arch" >&2; exit 1 ;; \
      esac; \
      name="codex-${arch}-unknown-linux-musl"; \
      mkdir -p /opt/aurora/harness/codex /tmp/codex-dl \
   && curl -fsSL --retry 3 -o "/tmp/codex-dl/${name}.tar.gz" \
        "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/${name}.tar.gz" \
   && echo "${sha}  /tmp/codex-dl/${name}.tar.gz" | sha256sum -c - \
   && tar -xzf "/tmp/codex-dl/${name}.tar.gz" -C /tmp/codex-dl \
   && install -m 0755 "/tmp/codex-dl/${name}" /opt/aurora/harness/codex/codex \
   && rm -rf /tmp/codex-dl \
   && test "$(/opt/aurora/harness/codex/codex --version)" = "codex-cli ${CODEX_VERSION}" ;; esac
# (phase 5, P5-HARN, D-361) Pinned Pi coding agent; must match PINNED_VERSION in
# services/aurora-supervisor/src/adapters/pi/mod.rs. The whole npm tree is pinned by
# images/sandbox/harness/pi/package-lock.json (`npm ci --ignore-scripts`, integrity-checked); Pi needs
# Node.js 22.19 or newer, which the base stage's AlmaLinux 10 `nodejs` provides (the build checks it).
ARG PI_VERSION=1.5.2
COPY images/sandbox/harness/pi/package.json images/sandbox/harness/pi/package-lock.json /tmp/pi-pin/
RUN case ",${SANDBOX_HARNESSES}," in *,pi,*) \
      node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a==22&&b>=19)?0:1)' \
   && mkdir -p /opt/aurora/harness/pi \
   && cp /tmp/pi-pin/package.json /tmp/pi-pin/package-lock.json /opt/aurora/harness/pi/ \
   && (cd /opt/aurora/harness/pi && npm ci --ignore-scripts --no-audit --no-fund) \
   && test "$(/opt/aurora/harness/pi/node_modules/.bin/pi --version)" = "${PI_VERSION}" ;; esac \
   && rm -rf /tmp/pi-pin
# (P5-HARN) Pinned goose (release v${GOOSE_VERSION}, the glibc build); must match PINNED_VERSION in
# services/aurora-supervisor/src/adapters/goose/mod.rs. Checksum-verified like Codex.
ARG GOOSE_VERSION=1.59.2
ARG GOOSE_SHA256_X86_64=c63cf82953e968d84b7542eb38a621dfdb5050b967728ed363517be5cdc666ea
ARG GOOSE_SHA256_AARCH64=ec2e0aded1e2aba8d310727a5138f2e3cce0769f2611fbe196ed014c31ce370a
RUN case ",${SANDBOX_HARNESSES}," in *,goose,*) \
      arch="$(uname -m)"; \
      case "$arch" in \
        x86_64) sha="${GOOSE_SHA256_X86_64}" ;; \
        aarch64) sha="${GOOSE_SHA256_AARCH64}" ;; \
        *) echo "no pinned goose build for $arch" >&2; exit 1 ;; \
      esac; \
      name="goose-${arch}-unknown-linux-gnu"; \
      mkdir -p /opt/aurora/harness/goose /tmp/goose-dl \
   && curl -fsSL --retry 3 -o "/tmp/goose-dl/${name}.tar.gz" \
        "https://github.com/aaif-goose/goose/releases/download/v${GOOSE_VERSION}/${name}.tar.gz" \
   && echo "${sha}  /tmp/goose-dl/${name}.tar.gz" | sha256sum -c - \
   && tar -xzf "/tmp/goose-dl/${name}.tar.gz" -C /tmp/goose-dl \
   && install -m 0755 /tmp/goose-dl/goose /opt/aurora/harness/goose/goose \
   && rm -rf /tmp/goose-dl \
   && test "$(/opt/aurora/harness/goose/goose --version | tr -d ' ')" = "${GOOSE_VERSION}" ;; esac
# (P5-HARN, D-363(b)) Pinned OpenCode on its v1.19.x line (release v${OPENCODE_VERSION}); must match
# PINNED_VERSION in services/aurora-supervisor/src/adapters/opencode/mod.rs. Checksum-verified.
ARG OPENCODE_VERSION=1.19.6
ARG OPENCODE_SHA256_X86_64=47734e08968b30cc22a0bffb6d9feeed76ad4aa743213a12122040392d09a057
ARG OPENCODE_SHA256_AARCH64=5b68c1f4c5e75b4134e664cc8f36d634d64208d4fcfe5bcf3b48bab699c2dbac
RUN case ",${SANDBOX_HARNESSES}," in *,opencode,*) \
      arch="$(uname -m)"; \
      case "$arch" in \
        x86_64) sha="${OPENCODE_SHA256_X86_64}"; name="opencode-linux-x64" ;; \
        aarch64) sha="${OPENCODE_SHA256_AARCH64}"; name="opencode-linux-arm64" ;; \
        *) echo "no pinned OpenCode build for $arch" >&2; exit 1 ;; \
      esac; \
      mkdir -p /opt/aurora/harness/opencode /tmp/opencode-dl \
   && curl -fsSL --retry 3 -o "/tmp/opencode-dl/${name}.tar.gz" \
        "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/${name}.tar.gz" \
   && echo "${sha}  /tmp/opencode-dl/${name}.tar.gz" | sha256sum -c - \
   && tar -xzf "/tmp/opencode-dl/${name}.tar.gz" -C /tmp/opencode-dl \
   && install -m 0755 /tmp/opencode-dl/opencode /opt/aurora/harness/opencode/opencode \
   && rm -rf /tmp/opencode-dl \
   && test "$(/opt/aurora/harness/opencode/opencode --version)" = "${OPENCODE_VERSION}" ;; esac
COPY --from=supervisor-builder /out/aurora-supervisor /usr/local/bin/aurora-supervisor
# (P4-PRV-2) preview round-trip e2e: a share's start command may run `preview-echo <port>`.
COPY --from=supervisor-builder /out/preview-echo /usr/local/bin/preview-echo
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/aurora-supervisor", "run"]

# ---- sandbox-min: OS + supervisor only (e2e)
FROM os AS sandbox-min
COPY --from=supervisor-builder /out/aurora-supervisor /usr/local/bin/aurora-supervisor
# (P4-PRV-2) preview round-trip e2e: the share's start command runs `preview-echo <port>`.
COPY --from=supervisor-builder /out/preview-echo /usr/local/bin/preview-echo
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/aurora-supervisor", "run"]
