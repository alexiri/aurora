# syntax=docker/dockerfile:1
# OPS-020. One Rust builder compiles every service binary once; each target copies its binary into a
# distroless, non-root image. Dependencies are a separate cached layer (cargo-chef), so a source-only
# change recompiles just the workspace crates. The linker is lld, as in CI and scripts/dev/linker.sh (OPS-016).
#   podman build -f images/services/Containerfile --target api -t aurora-api .
#
# Cache design: CI exports layers (cache-to type=gha), which does NOT include `--mount=type=cache`
# contents. So `target/` stays inside the layers (that is what makes the chef "cook" layer reusable
# across CI runs) and only the registry/git download caches use cache mounts.
#
# OPS-023, sccache: any source change invalidates `COPY . .`, so the layer cache alone recompiles every
# workspace crate. The cook and build steps therefore run through `with-sccache` (RUSTC_WRAPPER=sccache):
#   - local: `--mount=type=cache,target=/root/.cache/sccache` keeps compiled crates between builds;
#   - CI: the GitHub Actions cache backend. The runtime URL/token come in as BuildKit SECRETS
#     (`id=actions_results_url`, `id=actions_runtime_token`), mounted as files under /run/secrets for the
#     one RUN step: never build args, never in a layer or the provenance;
#   - neither available (fork PR, plain `podman build`): the secrets are simply absent and sccache uses the
#     (possibly empty) local directory; if sccache cannot start at all the build runs without it.
# Cache keys are stable because the build path is always /build and the env (RUSTFLAGS, CARGO_INCREMENTAL=0)
# is fixed in this file. sccache caches only lib/rlib crates; binaries and proc-macros always compile.
ARG RUST_IMAGE=docker.io/library/rust:1-bookworm

FROM ${RUST_IMAGE} AS chef
ARG CARGO_CHEF_VERSION=0.1.78
ARG SCCACHE_VERSION=0.10.0
ARG SCCACHE_SHA256_X86_64=1fbb35e135660d04a2d5e42b59c7874d39b3deb17de56330b25b713ec59f849b
ARG SCCACHE_SHA256_AARCH64=d6a1ce4acd02b937cd61bc675a8be029a60f7bc167594c33d75732bbc0a07400
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends clang lld \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install cargo-chef --locked --version ${CARGO_CHEF_VERSION}
# sccache: pinned release binary, checksum verified (no `cargo install`: that compiles for minutes).
RUN set -eu; arch=$(uname -m); \
    case "$arch" in x86_64) sum=${SCCACHE_SHA256_X86_64} ;; aarch64) sum=${SCCACHE_SHA256_AARCH64} ;; \
      *) echo "no sccache checksum for $arch" >&2; exit 1 ;; esac; \
    n=sccache-v${SCCACHE_VERSION}-$arch-unknown-linux-musl; \
    curl -fsSL -o /tmp/sccache.tgz https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/$n.tar.gz; \
    echo "$sum  /tmp/sccache.tgz" | sha256sum -c -; \
    tar -xzf /tmp/sccache.tgz -C /tmp; install -m 0755 /tmp/$n/sccache /usr/local/bin/sccache; \
    rm -rf /tmp/sccache.tgz /tmp/$n; sccache --version
# `with-sccache <cmd...>`: run a command with sccache as rustc wrapper and print the hit statistics.
# A plain file, not a heredoc: podman/buildah 4.9 (CI runners) cannot parse `COPY <<EOF`.
COPY images/services/with-sccache.sh /usr/local/bin/with-sccache
RUN chmod 0755 /usr/local/bin/with-sccache
# P2-CAT-H: hook-capable built-ins compile their guest crate to a WebAssembly component
# (`aurora plugin build`, docs/09 §12). The only extra toolchain is the wasm32-wasip2 rust-std of
# this image's own rustc (no `cargo component`: a cdylib on wasm32-wasip2 is already a component).
# rustup downloads it over HTTPS and verifies its SHA-256 against the channel manifest of the
# pinned toolchain; it lives in the build stages only. Installed here (not in plugin-archives) so
# this layer is cached across source changes.
RUN rustup target add wasm32-wasip2 && rustc --version && rustup target list --installed
WORKDIR /build
ENV SQLX_OFFLINE=true CARGO_TERM_COLOR=never CARGO_INCREMENTAL=0 \
    RUSTFLAGS="-C link-arg=-fuse-ld=lld"

# The recipe lists the dependency graph only, so it (and the cook layer) changes only when
# Cargo.toml/Cargo.lock change.
FROM chef AS planner
COPY . .
RUN rm -f rust-toolchain.toml && cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/root/.cache/sccache \
    --mount=type=secret,id=actions_results_url \
    --mount=type=secret,id=actions_runtime_token \
    with-sccache cargo chef cook --release --locked --recipe-path recipe.json \
      -p aurora-api -p aurora-gateway -p aurora-hookhost \
      -p aurora-runner -p aurora-connector-fake \
      -p aurora-connector-mattermost
COPY . .
# The repo pins a toolchain + wasm target via rust-toolchain.toml; the image's own stable toolchain
# is used for service builds.
RUN rm -f rust-toolchain.toml
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/root/.cache/sccache \
    --mount=type=secret,id=actions_results_url \
    --mount=type=secret,id=actions_runtime_token \
    with-sccache cargo build --release --locked \
      -p aurora-api -p aurora-gateway -p aurora-hookhost \
      -p aurora-runner -p aurora-connector-fake \
      -p aurora-connector-mattermost \
    && mkdir /out \
    && for b in aurora-api aurora-gateway aurora-hookhost aurora-runner aurora-connector-fake \
                 aurora-connector-mattermost; do \
         cp target/release/$b /out/; done

# Built-in app packages (P2-CAT-0, docs/09 §10): plugins/builtin/<id> -> <id>-<version>.aurora-plugin.
# Signed with the project key when the build gets the BuildKit/podman secret
# `aurora_project_signing_key` (base64 seed; CI passes it from the `release` environment, see
# docs/ops/builtin-plugin-signing.md). Without it the archives are unsigned and the API's builtin
# directory refuses them (fail closed). Only the `api` target uses this stage.
FROM builder AS plugin-archives
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/root/.cache/sccache \
    with-sccache cargo build --release --locked -p aurora-cli
# Step 1 compiles: `aurora plugin build` runs `cargo build --locked --target wasm32-wasip2` over the
# hook guest crate of every built-in that has hooks (plugins/builtin/<id>/hooks), which executes
# third-party build scripts and proc-macros. So this step has NO access to the signing key. The
# hook example (plugins/fixtures/hook-example, test-only, never shipped) is compiled too, so a
# broken wasm toolchain fails this image build even while no built-in has hooks yet.
# The toolchain (the wasm32-wasip2 rust-std, installed in the `chef` stage) exists only in these
# build stages; the `api` runtime image below copies nothing but /out-plugins.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/root/.cache/sccache \
    --mount=type=secret,id=actions_results_url \
    --mount=type=secret,id=actions_runtime_token \
    with-sccache sh -c 'set -eu; \
      bash scripts/plugins/build-builtin.sh --build-only --out /out-plugins --aurora target/release/aurora; \
      target/release/aurora plugin build plugins/fixtures/hook-example --out /tmp/hook-example.aurora-plugin; \
      tar -tzf /tmp/hook-example.aurora-plugin | grep -qx hooks.wasm; \
      echo "hook toolchain ok: hooks.wasm compiled and packed"; rm -f /tmp/hook-example.aurora-plugin'
# Step 2 signs the archives of step 1 (no cargo runs here, the key never meets build code).
RUN --mount=type=secret,id=aurora_project_signing_key,required=false \
    bash scripts/plugins/build-builtin.sh --sign-only --out /out-plugins --aurora target/release/aurora \
      --key-file /run/secrets/aurora_project_signing_key

FROM gcr.io/distroless/cc-debian12:nonroot AS api
COPY --from=builder /out/aurora-api /usr/local/bin/aurora-api
COPY --from=plugin-archives /out-plugins/ /usr/share/aurora/plugins/
EXPOSE 4101 4111
ENTRYPOINT ["/usr/local/bin/aurora-api"]
CMD ["serve"]

FROM gcr.io/distroless/cc-debian12:nonroot AS gateway
COPY --from=builder /out/aurora-gateway /usr/local/bin/aurora-gateway
EXPOSE 4102 4103
ENTRYPOINT ["/usr/local/bin/aurora-gateway"]

FROM gcr.io/distroless/cc-debian12:nonroot AS hookhost
COPY --from=builder /out/aurora-hookhost /usr/local/bin/aurora-hookhost
EXPOSE 4104
ENTRYPOINT ["/usr/local/bin/aurora-hookhost"]

FROM gcr.io/distroless/cc-debian12:nonroot AS runner
COPY --from=builder /out/aurora-runner /usr/local/bin/aurora-runner
EXPOSE 4106
ENTRYPOINT ["/usr/local/bin/aurora-runner"]

FROM gcr.io/distroless/cc-debian12:nonroot AS connector-fake
COPY --from=builder /out/aurora-connector-fake /usr/local/bin/aurora-connector-fake
EXPOSE 4190
ENTRYPOINT ["/usr/local/bin/aurora-connector-fake"]

# The Mattermost connector: public callbacks (/mm/actions, /mm/commands) on 4110, health on 4191.
#   podman build -f images/services/Containerfile --target connector-mattermost -t aurora-connector-mattermost .
FROM gcr.io/distroless/cc-debian12:nonroot AS connector-mattermost
COPY --from=builder /out/aurora-connector-mattermost /usr/local/bin/aurora-connector-mattermost
EXPOSE 4110 4191
ENTRYPOINT ["/usr/local/bin/aurora-connector-mattermost"]
CMD ["serve"]
