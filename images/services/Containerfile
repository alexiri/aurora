# syntax=docker/dockerfile:1
# OPS-020. One Rust builder compiles every service binary once; each target copies its binary into a
# distroless, non-root image. Dependencies are a separate cached layer (cargo-chef), so a source-only
# change recompiles just the workspace crates. The linker is lld, as in CI and scripts/dev/linker.sh (OPS-016).
#   podman build -f images/services/Containerfile --target api -t aurora-api .
#
# Cache design: CI exports layers (cache-to type=gha), which does NOT include `--mount=type=cache`
# contents. So `target/` stays inside the layers (that is what makes the chef "cook" layer reusable
# across CI runs) and only the registry/git download caches use cache mounts.
ARG RUST_IMAGE=docker.io/library/rust:1-bookworm

FROM ${RUST_IMAGE} AS chef
ARG CARGO_CHEF_VERSION=0.1.78
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends clang lld \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install cargo-chef --locked --version ${CARGO_CHEF_VERSION}
WORKDIR /build
ENV SQLX_OFFLINE=true CARGO_TERM_COLOR=never CARGO_INCREMENTAL=0 \
    RUSTFLAGS="-C link-arg=-fuse-ld=lld"

# The recipe lists the dependency graph only, so it (and the cook layer) changes only when
# Cargo.toml/Cargo.lock change.
FROM chef AS planner
COPY . .
RUN rm -f rust-toolchain.toml && cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo chef cook --release --locked --recipe-path recipe.json \
      -p aurora-api -p aurora-gateway -p aurora-hookhost \
      -p aurora-runner -p aurora-connector-fake \
      -p aurora-connector-mattermost
COPY . .
# The repo pins a toolchain + wasm target via rust-toolchain.toml; the image's own stable toolchain
# is used for service builds.
RUN rm -f rust-toolchain.toml
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo build --release --locked \
      -p aurora-api -p aurora-gateway -p aurora-hookhost \
      -p aurora-runner -p aurora-connector-fake \
      -p aurora-connector-mattermost \
    && mkdir /out \
    && for b in aurora-api aurora-gateway aurora-hookhost aurora-runner aurora-connector-fake \
                 aurora-connector-mattermost; do \
         cp target/release/$b /out/; done

FROM gcr.io/distroless/cc-debian12:nonroot AS api
COPY --from=builder /out/aurora-api /usr/local/bin/aurora-api
EXPOSE 4101 4111
ENTRYPOINT ["/usr/local/bin/aurora-api"]
CMD ["serve"]

FROM gcr.io/distroless/cc-debian12:nonroot AS gateway
COPY --from=builder /out/aurora-gateway /usr/local/bin/aurora-gateway
EXPOSE 4102 4103
ENTRYPOINT ["/usr/local/bin/aurora-gateway"]

FROM gcr.io/distroless/cc-debian12:nonroot AS hookhost
COPY --from=builder /out/aurora-hookhost /usr/local/bin/aurora-hookhost
EXPOSE 4104
ENTRYPOINT ["/usr/local/bin/aurora-hookhost"]

FROM gcr.io/distroless/cc-debian12:nonroot AS runner
COPY --from=builder /out/aurora-runner /usr/local/bin/aurora-runner
EXPOSE 4106
ENTRYPOINT ["/usr/local/bin/aurora-runner"]

FROM gcr.io/distroless/cc-debian12:nonroot AS connector-fake
COPY --from=builder /out/aurora-connector-fake /usr/local/bin/aurora-connector-fake
EXPOSE 4190
ENTRYPOINT ["/usr/local/bin/aurora-connector-fake"]

# The Mattermost connector: public callbacks (/mm/actions, /mm/commands) on 4110, health on 4191.
#   podman build -f images/services/Containerfile --target connector-mattermost -t aurora-connector-mattermost .
FROM gcr.io/distroless/cc-debian12:nonroot AS connector-mattermost
COPY --from=builder /out/aurora-connector-mattermost /usr/local/bin/aurora-connector-mattermost
EXPOSE 4110 4191
ENTRYPOINT ["/usr/local/bin/aurora-connector-mattermost"]
CMD ["serve"]
