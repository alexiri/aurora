      "format": "uuid",
      "type": "string"
    },
    "caption": {
      "type": [
        "string",
        "null"
      ]
    },
    "conversation_id": {
      "format": "uuid",
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "sandbox_id": {
      "format": "uuid",
      "type": "string"
    },
    "turn_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "sandbox_id",
    "boot_id",
    "conversation_id",
    "turn_id",
    "filename"
  ],
  "title": "AttachmentUploadMeta",
  "type": "object"
}
