{
  "$defs": {
    "HarnessId": {
      "maxLength": 64,
      "type": "string"
    },
    "HomeDurability": {
      "maxLength": 64,
      "type": "string"
    },
    "Range": {
      "properties": {
        "max": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "min": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "ResourceRanges": {
      "properties": {
        "cpu": {
          "$ref": "#/$defs/Range"
        },
        "home_gib": {
          "$ref": "#/$defs/Range"
        },
        "memory_mib": {
          "$ref": "#/$defs/Range"
        },
        "pids": {
          "$ref": "#/$defs/Range"
        }
      },
      "required": [
        "cpu",
        "memory_mib",
        "pids",
        "home_gib"
      ],
      "type": "object"
    },
    "RunnerCapabilities": {
      "properties": {
        "backend": {
          "type": "string"
        },
        "defaults": {
          "anyOf": [
            {
              "$ref": "#/$defs/SandboxDefaults"
            },
            {
              "type": "null"
            }
          ],
          "description": "(FIX-011, D-90) The runner's configured sandbox defaults (`runner.sandbox_cpus`,\n`sandbox_memory_mib`, `sandbox_pids`, `home_gib`): the API uses them when neither the\nagent nor the org overrides a resource axis. Absent from older runners."
        },
        "harnesses": {
          "items": {
            "$ref": "#/$defs/HarnessId"
          },
          "type": "array"
        },
        "held_awake_ceiling": {
          "description": "`runner.held_awake_ceiling` (docs/11 §Stop): running-but-idle sandboxes above this make\ndue-work evict for a waiting start. Absent from older runners: the API derives\n`max(1, max_sandboxes − 1)`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "home_durability": {
          "$ref": "#/$defs/HomeDurability"
        },
        "image": {
          "description": "The sandbox image this runner starts (`runner.image`); the single source of truth the\nAPI reports in `SandboxView.image`. Absent from older runners.",
          "type": [
            "string",
            "null"
          ]
        },
        "image_capabilities": {
          "description": "(phase 1, RFE-003) Capabilities the sandbox image declares in its\n`org.aurora.capabilities` label (docs/11 §The boot document); phase 1 defines\n`browser`. Open vocabulary; absent = none (fail closed, also for older runners).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_attachment_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_sandboxes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "previews": {
          "description": "(phase 4, P4-PRV-2, D-147) The runner opened the relay-facing stream listener :4108 and\nspeaks the W18 stream frames; the API places no preview share on a runner without it.\nAbsent (false) from older runners.",
          "type": "boolean"
        },
        "resources": {
          "$ref": "#/$defs/ResourceRanges"
        },
        "stream_tls": {
          "description": "(P4-PRV-2, `16 §W18`) The stream listener speaks TLS (`runner.stream_tls`): the API\ndials `wss://` instead of `ws://` in the runner endpoint it gives the relay. Absent\n(false) from older runners — matches the default off in-cluster.",
          "type": "boolean"
        }
      },
      "required": [
        "backend",
        "home_durability",
        "resources",
        "max_sandboxes",
        "harnesses",
        "max_attachment_bytes"
      ],
      "type": "object"
    },
    "SandboxDefaults": {
      "description": "Per-sandbox resource defaults of a runner (FIX-011, D-90).",
      "properties": {
        "cpu_millis": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "home_gib": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "memory_mib": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pids": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpu_millis",
        "memory_mib",
        "pids",
        "home_gib"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "advertised_host": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/RunnerCapabilities"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "backend",
    "capabilities",
    "advertised_host"
  ],
  "title": "RegisterRequest",
  "type": "object"
}
