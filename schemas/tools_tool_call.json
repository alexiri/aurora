    },
    "call_id": {
      "type": "string"
    },
    "conversation_id": {
      "format": "uuid",
      "type": "string"
    },
    "sandbox_id": {
      "format": "uuid",
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
