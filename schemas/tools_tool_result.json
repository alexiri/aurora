        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "call_id",
    "ok"
  ],
  "title": "ToolResult",
  "type": "object"
}
