        "value": true
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "TextContent": {
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "ToolContent": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/TextContent"
            },
            {
              "properties": {
                "type": {
                  "const": "text"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/JsonContent"
            },
            {
              "properties": {
                "type": {
                  "const": "json"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            }
          ]
        },
        {
          "description": "unknown kind; consumers log and skip",
          "properties": {
            "type": {
              "maxLength": 64,
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ToolError": {
      "properties": {
