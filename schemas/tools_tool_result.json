          "$ref": "#/$defs/BoundedString64"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`{ call_id, ok: true, content }` or `{ call_id, ok: false, error }`.",
  "properties": {
    "call_id": {
      "type": "string"
    },
    "content": {
      "items": {
