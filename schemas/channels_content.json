{
  "$defs": {
    "Block": {
      "oneOf": [
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "header",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "pairs": {
              "items": {
                "$ref": "#/$defs/Field"
              },
              "type": "array"
            },
            "type": {
              "const": "fields",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pairs"
          ],
          "type": "object"
        },
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "context",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "label": {
              "type": "string"
            },
            "type": {
              "const": "link",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "label",
            "url"
          ],
          "type": "object"
        },
        {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/ButtonItem"
              },
              "type": "array"
            },
            "type": {
              "const": "buttons",
              "type": "string"
            }
          },
          "required": [
            "type",
            "items"
          ],
          "type": "object"
        },
        {
          "properties": {
            "options": {
              "items": {
                "$ref": "#/$defs/SelectOption"
              },
              "type": "array"
            },
            "placeholder": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "type": {
              "const": "select",
              "type": "string"
            }
          },
          "required": [
            "type",
            "placeholder",
            "options",
            "token"
          ],
          "type": "object"
        },
        {
          "properties": {
            "label": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "type": {
              "const": "input",
              "type": "string"
            }
          },
          "required": [
            "type",
            "label",
            "token"
          ],
          "type": "object"
        }
      ]
    },
    "ButtonItem": {
      "properties": {
        "label": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/ButtonStyle",
          "default": "default"
        },
        "token": {
          "description": "Opaque action token; connectors never interpret it.",
          "type": "string"
        }
      },
      "required": [
        "label",
        "token"
      ],
      "type": "object"
    },
    "ButtonStyle": {
      "enum": [
        "primary",
        "danger",
        "default"
      ],
      "type": "string"
    },
    "Card": {
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "type": "array"
        }
      },
      "required": [
        "blocks"
      ],
      "type": "object"
    },
    "Field": {
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "type": "object"
    },
    "Narration": {
      "description": "The narration card (C-847): the running form lists the last steps; the collapsed form\n(D-286, `collapsed: true`) carries only the counts and the elapsed time.",
      "properties": {
        "collapsed": {
          "type": "boolean"
        },
        "earlier": {
          "default": 0,
          "description": "Steps cut from the front of `steps` (\"N earlier\").",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "elapsed_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "failed_count": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/NarrationStatus"
        },
        "step_count": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/NarrationStep"
          },
          "type": "array"
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "status"
      ],
      "type": "object"
    },
    "NarrationStatus": {
      "description": "Where a narration card's turn stands (C-847).",
      "enum": [
        "running",
        "done",
        "failed",
        "stopped"
      ],
      "type": "string"
    },
    "NarrationStep": {
      "description": "One tool step of a narration card.",
      "properties": {
        "detail": {
          "description": "The sanitized summary; present only in a `direct` conversation (C-850).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The tool's name, at most `NARR_STEP_CHARS`.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/NarrationStepStatus",
          "description": "`running` | `ok` | `failed`."
        }
      },
      "required": [
        "name",
        "status"
      ],
      "type": "object"
    },
    "NarrationStepStatus": {
      "enum": [
        "running",
        "ok",
        "failed"
      ],
      "type": "string"
    },
    "SelectOption": {
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "card": {
      "anyOf": [
        {
          "$ref": "#/$defs/Card"
        },
        {
          "type": "null"
        }
      ]
    },
    "narration": {
      "anyOf": [
        {
          "$ref": "#/$defs/Narration"
        },
        {
          "type": "null"
        }
      ],
      "description": "(P4-NARR, C-847) A platform-authored progress card, rendered as data by the connector."
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "Content",
  "type": "object"
}
