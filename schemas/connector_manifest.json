        "writes_per_space_per_minute": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ManifestPackage": {
      "properties": {
        "contract": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "contract",
        "publisher"
      ],
      "type": "object"
    }
