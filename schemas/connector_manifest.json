    },
    "package": {
      "$ref": "#/$defs/ManifestPackage"
    },
    "presence_setup": {
      "default": null
    },
    "public_callbacks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "package",
    "about"
  ],
  "title": "ConnectorManifest",
  "type": "object"
}
