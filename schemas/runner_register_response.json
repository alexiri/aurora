{
  "$defs": {
    "RunnerConfig": {
      "properties": {
        "idle_stop_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "orphan_grace_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "poll_wait_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "previews": {
          "description": "(phase 4, P4-PRV-2, D-147) When true the runner must open the relay-facing\nstream listener :4108 and speak the W18 stream frames. Absent (false) for\nolder runners, so legacy runners never open the port.",
          "type": "boolean"
        },
        "reconcile_interval_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "terminal": {
          "description": "(phase 4, P4-TERM, D-161) When true the runner must open the stream listener\n:4108 for terminal grants too and speak the W19 `pty.*` frames. Absent (false)\nfor older runners. The listener opens when **either** flag is set (C-623).",
          "type": "boolean"
        }
      },
      "required": [
        "poll_wait_secs",
        "reconcile_interval_secs",
        "orphan_grace_secs",
        "idle_stop_secs"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "config": {
      "$ref": "#/$defs/RunnerConfig"
    },
    "protocol": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "replica_id": {
      "format": "uuid",
      "type": "string"
    },
    "runner_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "runner_id",
    "replica_id",
    "protocol",
    "config"
  ],
  "title": "RegisterResponse",
  "type": "object"
}
